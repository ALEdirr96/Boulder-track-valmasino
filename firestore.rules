rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: blocks
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - area: string (required)
    //   - lat: number (required)
    //   - lng: number (required)
    //   - status: string (required, ['new', 'clean', 'to_clean', 'project'])
    //   - grade: string (optional)
    //   - height: string (optional)
    //   - style: string (optional)
    //   - exposure: string (optional)
    //   - accessNotes: string (optional)
    //   - landingNotes: string (optional)
    //   - riskLevel: string (optional)
    //   - photos: list (optional)
    //   - linePhoto: string (optional)
    //   - createdAt: timestamp (required)
    //   - createdBy: string (required, UID)
    //   - createdByEmail: string (optional)
    //   - visited: bool (optional)
    //   - favorite: bool (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isValidBlock(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.area is string && data.area.size() > 0 && data.area.size() < 100 &&
             data.lat is number && data.lng is number &&
             data.status in ['new', 'clean', 'to_clean', 'project'] &&
             (!('height' in data) || (data.height is string && data.height.size() < 20)) &&
             (!('style' in data) || (data.style is string && data.style.size() < 50)) &&
             (!('exposure' in data) || (data.exposure is string && data.exposure.size() < 50)) &&
             (!('accessNotes' in data) || (data.accessNotes is string && data.accessNotes.size() < 1000)) &&
             (!('landingNotes' in data) || (data.landingNotes is string && data.landingNotes.size() < 1000)) &&
             (!('riskLevel' in data) || (data.riskLevel is string && data.riskLevel.size() < 50)) &&
             (!('photos' in data) || (data.photos is list && data.photos.size() <= 5)) &&
             (!('linePhoto' in data) || (data.linePhoto is string && data.linePhoto.size() < 2000)) &&
             (!('lines' in data) || (data.lines is list && data.lines.size() <= 15)) &&
             (!('projectOwner' in data) || (data.projectOwner is string && data.projectOwner.size() < 128)) &&
             (!('createdByDisplayName' in data) || (data.createdByDisplayName is string && data.createdByDisplayName.size() < 128)) &&
             (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() < 128)) &&
             (!('type' in data) || (data.type is string && data.type in ['blocco', 'falesia'])) &&
             (!('approachTime' in data) || (data.approachTime is string && data.approachTime.size() < 100)) &&
             (!('parkingCoords' in data) || (data.parkingCoords is map && data.parkingCoords.lat is number && data.parkingCoords.lng is number)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             data.createdAt is timestamp &&
             data.createdBy is string && data.createdBy.size() < 128 &&
             (!('visited' in data) || data.visited is bool) &&
             (!('favorite' in data) || data.favorite is bool);
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             (request.auth.token.email.lower() == 'asdadmin@scalamasino.com' || 
              request.auth.token.email.lower() == 'asdadmin@valmasinoclimbing.com' || 
              request.auth.token.email.lower() == 'videoclipalessandrosangiorgio@gmail.com');
    }

    function isActive() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'pending')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 1000 &&
             data.date is string && data.date.size() == 10 &&
             data.time is string && data.time.size() <= 10 &&
             data.type in ['cleaning_day', 'general', 'gathering', 'meeting'] &&
             data.location is string && data.location.size() <= 120 &&
             data.createdBy is string && data.createdBy.size() < 128 &&
             (!('createdByDisplayName' in data) || (data.createdByDisplayName is string && data.createdByDisplayName.size() < 128)) &&
             (!('participants' in data) || (data.participants is list && data.participants.size() <= 100)) &&
             data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.equipmentId is string && data.equipmentId.size() < 128 &&
             data.equipmentName is string && data.equipmentName.size() > 0 && data.equipmentName.size() < 128 &&
             data.userId is string && data.userId.size() < 128 &&
             (!('userDisplayName' in data) || (data.userDisplayName is string && data.userDisplayName.size() < 128)) &&
             data.startDate is string && data.startDate.size() == 10 &&
             data.endDate is string && data.endDate.size() == 10 &&
             data.status in ['pending', 'approved', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow self-registration as pending, or superadmin as active/admin
      allow create: if isOwner(userId) && 
                      (
                        (request.resource.data.role == 'user' && request.resource.data.status == 'pending') ||
                        (isSuperAdmin() && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
                      );
      // Admins can create users directly
      allow create: if isAdmin();
      
      // Update: Super admin can do anything. Admins can update status/role. Users can update their profile.
      allow update: if isSuperAdmin() || 
                    (isAdmin() && userId != request.auth.uid) ||
                    (isOwner(userId) && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
                     resource.data.status == 'active');
      allow delete: if isSuperAdmin() || (isAdmin() && userId != request.auth.uid);
    }

    match /blocks/{blockId} {
      allow read: if isActive() || resource.data.status == 'clean';
      
      allow create: if isActive() && 
                      isValidBlock(request.resource.data) && 
                      request.resource.data.createdBy == request.auth.uid;
      
      allow update: if isActive() && 
                      (
                        ((isDocOwner() || isAdmin()) && 
                          isValidBlock(request.resource.data) && 
                          request.resource.data.createdBy == resource.data.createdBy) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorite', 'visited']))
                      );
                      
      allow delete: if isActive() && (isDocOwner() || isAdmin());

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if (
                                  (isActive() && request.auth.uid == reviewId && request.resource.data.userId == request.auth.uid) ||
                                  (reviewId.startsWith('guest_') && request.resource.data.userId == reviewId)
                                ) &&
                                request.resource.data.rating is int &&
                                request.resource.data.rating >= 0 &&
                                request.resource.data.rating <= 5 &&
                                request.resource.data.comment is string &&
                                request.resource.data.hasClimbed is bool;
        allow delete: if (isActive() && (request.auth.uid == reviewId || isAdmin())) ||
                        (reviewId.startsWith('guest_'));
      }
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /equipment/{equipmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /equipment_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isActive() && isValidEvent(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive() && (
        (isAdmin() && isValidEvent(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) && request.resource.data.participants is list && request.resource.data.participants.size() <= 100)
      );
      allow delete: if isActive() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /equipment_bookings/{bookingId} {
      allow read: if true;
      allow create: if isActive() && isValidBooking(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isActive() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate', 'endDate', 'status']) && request.resource.data.status == 'cancelled') ||
        (isAdmin() && isValidBooking(request.resource.data))
      );
      allow delete: if isActive() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
