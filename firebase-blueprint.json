{
  "entities": {
    "Block": {
      "title": "Block",
      "description": "A boulder problem or block.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the block" },
        "area": { "type": "string", "description": "Sector or area" },
        "lat": { "type": "number", "description": "Latitude" },
        "lng": { "type": "number", "description": "Longitude" },
        "status": { "type": "string", "enum": ["new", "clean", "to_clean", "project"], "description": "Status of the block" },
        "grade": { "type": "string", "description": "Difficulty grade" },
        "height": { "type": "string", "description": "Estimated height" },
        "style": { "type": "string", "description": "Climbing style" },
        "exposure": { "type": "string", "description": "Sun exposure" },
        "accessNotes": { "type": "string", "description": "Notes on how to reach the block" },
        "landingNotes": { "type": "string", "description": "Notes on the landing safety" },
        "riskLevel": { "type": "string", "description": "Perceived danger level" },
        "photos": { "type": "array", "items": { "type": "string" }, "description": "URLs of photos" },
        "linePhoto": { "type": "string", "description": "URL of the topo/line photo" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "User who added the block" },
        "createdByEmail": { "type": "string", "description": "Email of the user who added the block" },
        "createdByDisplayName": { "type": "string", "description": "Display name of the user who added the block" },
        "projectOwner": { "type": "string", "description": "Original discoverer or project owner" },
        "visited": { "type": "boolean", "description": "Whether the user has visited it" },
        "favorite": { "type": "boolean", "description": "Whether it's a favorite" }
      },
      "required": ["name", "area", "lat", "lng", "status", "createdAt", "createdBy"]
    },
    "Log": {
      "title": "Log",
      "description": "An activity log entry",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Human-readable description" },
        "type": { "type": "string", "description": "Log type category" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" },
        "createdBy": { "type": "string", "description": "User UID who triggered this" },
        "createdByEmail": { "type": "string", "description": "User email who triggered this" },
        "createdByDisplayName": { "type": "string", "description": "User name who triggered this" }
      },
      "required": ["action", "createdAt", "createdBy"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App personalization settings",
      "type": "object",
      "properties": {
        "accentColor": { "type": "string", "description": "Primary accent preset name" },
        "logoText": { "type": "string", "description": "Custom logo text branding" },
        "showLogoSymbol": { "type": "boolean", "description": "Whether to display the logo graphic icon" }
      },
      "required": ["accentColor", "logoText"]
    },
    "BlockReview": {
      "title": "BlockReview",
      "description": "User feedback, rating in sassi, and completion toggle",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "hasClimbed": { "type": "boolean" },
        "climbedLines": { "type": "array", "items": { "type": "string" }, "description": "IDs of block lines successfully climbed" },
        "createdAt": { "type": "string", "format": "date" }
      },
      "required": ["userId", "userEmail", "rating", "comment", "hasClimbed"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Association equipment registry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the equipment" },
        "category": { "type": "string", "description": "Category of the equipment" },
        "status": { "type": "string", "enum": ["available", "borrowed", "maintenance"], "description": "Current status" },
        "serialNumber": { "type": "string", "description": "Optional serial number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "category", "status", "createdAt"]
    },
    "EquipmentLog": {
      "title": "EquipmentLog",
      "description": "Log of actions performed on equipment",
      "type": "object",
      "properties": {
        "equipmentId": { "type": "string", "description": "Associated equipment ID" },
        "equipmentName": { "type": "string", "description": "Name of the equipment" },
        "personName": { "type": "string", "description": "Name of the person who took/returned the item" },
        "action": { "type": "string", "enum": ["borrow", "return", "maintenance"], "description": "Logged action type" },
        "dateTime": { "type": "string", "format": "date-time", "description": "Timestamp of action" },
        "adminId": { "type": "string", "description": "Admin UID who processed the action" },
        "notes": { "type": "string", "description": "Optional details" }
      },
      "required": ["equipmentId", "equipmentName", "personName", "action", "dateTime", "adminId"]
    },
    "Event": {
      "title": "Event",
      "description": "Calendar events like group cleaning days and gatherings",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the event" },
        "description": { "type": "string", "description": "Event detailed description" },
        "date": { "type": "string", "description": "Event date (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Event event meeting time (HH:MM)" },
        "type": { "type": "string", "enum": ["cleaning_day", "general", "gathering", "meeting"], "description": "Event type" },
        "createdBy": { "type": "string", "description": "User UID who created the event" },
        "createdByDisplayName": { "type": "string", "description": "Display name of the creator" },
        "location": { "type": "string", "description": "Event location coordinate or descriptive meeting spot" },
        "participants": { "type": "array", "items": { "type": "string" }, "description": "Array of participant user UIDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["title", "date", "type", "createdBy", "createdAt"]
    },
    "EquipmentBooking": {
      "title": "EquipmentBooking",
      "description": "Booking reservation of association equipment",
      "type": "object",
      "properties": {
        "equipmentId": { "type": "string", "description": "ID of the associated equipment" },
        "equipmentName": { "type": "string", "description": "Name of the associated equipment" },
        "userId": { "type": "string", "description": "User UID who reserved" },
        "userDisplayName": { "type": "string", "description": "Display name of the reserving user" },
        "startDate": { "type": "string", "description": "Start date of booking (YYYY-MM-DD)" },
        "endDate": { "type": "string", "description": "End date of booking (YYYY-MM-DD)" },
        "status": { "type": "string", "enum": ["pending", "approved", "cancelled"], "description": "Booking status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["equipmentId", "equipmentName", "userId", "userDisplayName", "startDate", "endDate", "status", "createdAt"]
    }
  },
  "firestore": {
    "/blocks/{blockId}": {
      "schema": "Block",
      "description": "Collection of boulder blocks"
    },
    "/blocks/{blockId}/reviews/{reviewId}": {
      "schema": "BlockReview",
      "description": "Feedback, ratings in sassi, and climbing ascent checklist for each block"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "History logs of actions and events"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Configuration presets"
    },
    "/equipment/{equipmentId}": {
      "schema": "Equipment",
      "description": "Association equipment registry"
    },
    "/equipment_logs/{logId}": {
      "schema": "EquipmentLog",
      "description": "Audit logs for equipment movements and actions"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Group cleaning events and administrative/social gathers"
    },
    "/equipment_bookings/{bookingId}": {
      "schema": "EquipmentBooking",
      "description": "Equipment reservation bookings list"
    }
  }
}
